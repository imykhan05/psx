# PSX AI Scanner — environment secrets
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and
# never committed. In LOCAL dev these are read via python-dotenv; on Render they
# are set in the dashboard (Environment tab), NOT in git — see docs/DEPLOYMENT.md.

# Anthropic API key for the NL assistant (/query endpoint + terminal "AI
# Assistant" tab). Optional: if unset, those features return a clean error and
# everything else works.
ANTHROPIC_API_KEY=

# Shared API key the FastAPI backend checks via the X-API-Key header. Invent a
# long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
# The web/mobile clients must send this same value. If unset, the API falls back
# to the dev key "psx-dev-key-change-me" — fine locally, NEVER in production.
PSX_API_KEY=

# Comma-separated allowed CORS origins for the API. "*" is open (dev default).
# In production, set this to your web app's exact origin, e.g.
# https://psx-dashboard.onrender.com
PSX_CORS_ORIGINS=*
