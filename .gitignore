# =============================================================================
# PSX AI Scanner — .gitignore
#
# Goal: commit CODE + the handful of SMALL output files the deployed API serves,
# and NOTHING heavy (venv, caches, the SQLite DB, raw/historical market data,
# model weights, build artifacts). The four whitelisted output files at the
# bottom are what Render reads; tools/publish_outputs.py refreshes them.
# =============================================================================

# --- Secrets ---------------------------------------------------------------
.env
*.env
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Local tools (downloaded on demand by run_public_api.bat) ---------------
bin/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- Databases (heavy, local-only) -----------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Model weights / large binaries ----------------------------------------
*.bin
*.safetensors
*.pt
*.onnx

# --- Logs ------------------------------------------------------------------
logs/
*.log
*.out

# --- Frontend (React) ------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Mobile (Flutter) ------------------------------------------------------
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins*
mobile/**/*.apk
mobile/**/*.ipa

# --- Raw / historical source data (heavy) ----------------------------------
database/historical_files/
*.Z
psx_history*.csv
psx_history_clean.csv

# =============================================================================
# database/ : ignore the whole tree EXCEPT the two small JSON outputs the API
# reads. (We never ignore the ai_learning/ directory itself, so the negations
# below can re-include files inside it.)
# =============================================================================
/database/*
!/database/ai_learning/
/database/ai_learning/*
!/database/ai_learning/daily_signal.json
!/database/ai_learning/sentiment_cache.json

# =============================================================================
# reports/ : ignore everything EXCEPT the small artifacts the API serves from
# reports/latest/. Backtests, action plans, logs, and the large per-symbol
# dumps stay out of git.
# =============================================================================
/reports/*
!/reports/latest/
/reports/latest/*
!/reports/latest/top_buys.csv
!/reports/latest/full_market_scan.csv
!/reports/latest/metadata.json
